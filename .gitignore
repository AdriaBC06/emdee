# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging / build artefacts
build/
dist/
sdist/
wheels/
*.egg-info/
*.egg
.eggs/
MANIFEST
# PyInstaller writes a .spec next to whatever it is told to build, and those
# generated ones are throwaway. The Windows spec is hand-written and is the
# actual build definition, so it is exempted below rather than left to be
# ignored in silence — the failure mode is a release workflow that cannot find
# its own build file.
*.spec
!packaging/windows/*.spec

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Testing and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ------------------------------------------------------------------ Qt
# Compiled Designer/resource output. Emdee builds its UI in Python and has no
# .qrc at all (pyrcc6 does not exist for PyQt6), but keep these ignored so a
# stray generated file never lands in a commit.
ui_*.py
*_rc.py
*.qmlc
*.jsc

# --------------------------------------------------------------- project
# Export output and manual-testing scratch. Emdee writes .html/.pdf next to the
# document being exported, which during development is this very repository.
*.pdf
*.html
/out/
/scratch/
/tmp/

# Pasted clipboard images are written next to the document being edited.
assets/

# Generated at install time from the SVG sources; never edit or commit these.
packaging/icons/contact-sheet.png

# Internal production notes, not documentation for anyone arriving from outside.
screenshots/README.md

# Local, machine-specific configuration that must never be published.
.env
.env.*
*.local
*.local.*
.direnv/
settings.ini
emdee.conf

# Editor and OS noise
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
